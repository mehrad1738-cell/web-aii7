{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-aii7",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1c6e3c35-c1c4-48dd-8e08-67eef2c6a144","database_name": "web-aii55" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9774b5a798a744e7833abe6d90a10abc" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
